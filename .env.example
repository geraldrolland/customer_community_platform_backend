# ============================================================================
# HappenHub Backend - Environment Configuration
# ============================================================================
# Copy this file to `.env` and adjust the values for your environment:
#   cp .env.example .env
#
# Every variable is optional - the application ships with safe development
# defaults. NEVER commit a real `.env` file (it is gitignored).
# ============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="HappenHub"

# --- JWT / Security ----------------------------------------------------------
# IMPORTANT: change this in any non-local environment.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
# Secret used to sign the auth cookie value. Defaults to JWT_SECRET.
COOKIE_SIGNING_SECRET=""

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=7
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cookies ------------------------------------------------------------------
AUTH_TOKEN_COOKIE="auth_token"
CSRF_TOKEN_COOKIE="csrf_token"

# --- CORS / Trusted Hosts ------------------------------------------------------
# NOTE: list-typed settings use JSON array syntax (pydantic-settings v2).
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
TRUSTED_HOSTS=["localhost", "127.0.0.1", "testserver"]
